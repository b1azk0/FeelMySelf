---
import { formatPrice } from '../../lib/woo';
import type { Product } from '../../lib/woo';

interface Props {
  product: Pick<Product, 'priceMinor' | 'regularPriceMinor' | 'currencySymbol' | 'onSale'>;
}

const { product } = Astro.props;
const isDiscounted = product.onSale && product.regularPriceMinor > product.priceMinor;
---
<div class="flex items-baseline gap-2">
  {isDiscounted ? (
    <>
      <span class="text-2xl font-bold text-brand-primary">{formatPrice(product)}</span>
      <span class="text-base text-muted line-through">
        {formatPrice({ priceMinor: product.regularPriceMinor, currencySymbol: product.currencySymbol })}
      </span>
    </>
  ) : (
    <span class="text-2xl font-bold text-brand-primary">{formatPrice(product)}</span>
  )}
</div>
