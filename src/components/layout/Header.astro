---
import Container from '../primitives/Container.astro';
import Image from '../primitives/Image.astro';
import Nav from './Nav.astro';

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;

const headerClass = transparent
  ? 'absolute inset-x-0 top-0 z-50 bg-transparent text-white transition-colors duration-200'
  : 'sticky top-0 z-50 border-b border-divider bg-white';

const blackLogoSrc = 'https://www.feelmyself.pl/wp-content/uploads/2025/08/Feel-My-Self_black_transparent.png';
const whiteLogoSrc = '/homepage/logo-white.png';
---
<header class={headerClass} data-transparent={transparent}>
  <Container size="xl">
    <div class="grid grid-cols-3 items-center min-h-[80px] py-4 gap-4">

      <div class="justify-self-start">
        <div class="hidden md:block">
          <Nav />
        </div>
        <details class="md:hidden relative">
          <summary
            class="cursor-pointer list-none inline-flex items-center p-2 hover:opacity-70 transition-opacity"
            aria-label="Otwórz menu"
          >
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
              <path d="M3 6h18v2H3V6zm0 5h18v2H3v-2zm0 5h18v2H3v-2z" />
            </svg>
          </summary>
          <div
            class="absolute left-0 top-full mt-2 bg-white text-brand-primary border border-divider shadow-card p-5 min-w-[180px] z-50"
          >
            <Nav orientation="vertical" />
          </div>
        </details>
      </div>

      <div class="justify-self-center">
        <a href="/" aria-label="Feel My Self – strona główna" class="block">
          {transparent ? (
            <>
              <Image
                src={whiteLogoSrc}
                alt="Feel My Self"
                width={150}
                height={140}
                loading="eager"
                class="logo-white h-16 w-auto"
              />
              <Image
                src={blackLogoSrc}
                alt="Feel My Self"
                width={150}
                height={140}
                loading="eager"
                class="logo-black h-16 w-auto"
              />
            </>
          ) : (
            <Image
              src={blackLogoSrc}
              alt="Feel My Self"
              width={150}
              height={140}
              loading="eager"
              class="h-16 w-auto"
            />
          )}
        </a>
      </div>

      <div class="justify-self-end">
        <details class="relative">
          <summary
            class="cursor-pointer list-none inline-flex items-center p-2 hover:opacity-70 transition-opacity"
            aria-label="Wyszukaj"
          >
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M10.875 3.75a7.125 7.125 0 100 14.25 7.125 7.125 0 000-14.25zM2.25 10.875a8.625 8.625 0 1117.25 0 8.625 8.625 0 01-17.25 0z" />
              <path fill-rule="evenodd" d="M15.913 15.914a.75.75 0 011.06 0l4.557 4.556a.75.75 0 01-1.06 1.06l-4.557-4.556a.75.75 0 010-1.06z" />
            </svg>
          </summary>
          <form
            action="/sklep"
            method="get"
            role="search"
            class="absolute right-0 top-full mt-2 bg-white text-brand-primary border border-divider shadow-card p-3 flex items-center gap-2 z-50"
          >
            <label class="sr-only" for="site-search">Szukaj</label>
            <input
              id="site-search"
              type="search"
              name="s"
              placeholder="Szukaj produktów…"
              class="border border-divider px-3 py-2 text-sm text-brand-primary focus:outline-none focus:border-brand-primary min-w-[220px]"
              autofocus
            />
          </form>
        </details>
      </div>

    </div>
  </Container>
</header>

{transparent && (
  <script is:inline>
    (function () {
      const header = document.querySelector('header[data-transparent="true"]');
      if (!header) return;
      const onScroll = () => {
        header.classList.toggle('is-scrolled', window.scrollY > 80);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    })();
  </script>
)}
