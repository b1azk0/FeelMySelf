---
const links = [
  { href: '/sklep', label: 'Sklep' },
  { href: '/blog', label: 'Blog' },
];
---
<nav class="flex items-center gap-6" aria-label="Główna nawigacja">
  {links.map((l) => (
    <a
      href={l.href}
      class="hover:opacity-70 transition-opacity text-sm font-medium"
    >
      {l.label}
    </a>
  ))}
</nav>
