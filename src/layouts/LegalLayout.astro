---
import BaseLayout from './BaseLayout.astro';
import Container from '../components/primitives/Container.astro';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    effectiveDate?: string;
  };
}

const { frontmatter } = Astro.props;
---
<BaseLayout
  title={`${frontmatter.title} – Feel My Self`}
  description={frontmatter.description}
  noindex
>
  <Container size="md">
    <article class="prose prose-neutral max-w-none py-12 md:py-16
      prose-headings:font-extrabold
      prose-h1:text-3xl prose-h1:md:text-4xl prose-h1:mb-6
      prose-h2:text-xl prose-h2:md:text-2xl prose-h2:mt-10
      prose-h3:text-lg prose-h3:mt-6
      prose-a:text-brand-primary prose-a:underline hover:prose-a:text-brand-secondary
      prose-table:text-sm
      prose-th:text-left prose-th:bg-card prose-th:px-3 prose-th:py-2
      prose-td:align-top prose-td:px-3 prose-td:py-2
      prose-blockquote:border-l-brand-primary prose-blockquote:text-brand-primary
    ">
      <slot />
      {frontmatter.effectiveDate && (
        <p class="mt-12 pt-6 border-t border-divider text-sm text-muted not-prose">
          Obowiązuje od: {frontmatter.effectiveDate}
        </p>
      )}
    </article>
  </Container>
</BaseLayout>
